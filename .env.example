# ============================================
# 🌐 APP SETTINGS
# ============================================

PORT=3000
NODE_ENV=development

# ============================================
# 🗄️ DATABASE (PostgreSQL + pgvector)
# ============================================
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# ============================================
# 🔐 JWT AUTHENTICATION
# ============================================

# JWT Access
JWT_SECRET="CHANGE_ME_ACCESS_TOKEN_SECRET_MIN_32_CHARS"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"

# JWT Refresh
JWT_REFRESH_TOKEN_SECRET="CHANGE_ME_REFRESH_SECRET"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# Account Verification
JWT_VERIFICATION_TOKEN_SECRET="CHANGE_ME_VERIFICATION_SECRET"
JWT_VERIFICATION_TOKEN_EXPIRES_IN="24h"

# Password Reset
JWT_PASSWORD_RESET_TOKEN_SECRET="CHANGE_ME_PASSWORD_RESET_SECRET"
JWT_PASSWORD_RESET_TOKEN_EXPIRES_IN="1h"

# ============================================
# ⚡ CACHE / REDIS (BullMQ + CacheService)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # Opcional — usar se o Redis tiver autenticação

# ============================================
# 🤖 ARTIFICIAL INTELLIGENCE (Groq)
# ============================================

# Groq Cloud API — https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings (local via Transformers.js — sem chave necessária)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# BullMQ — número de jobs de IA em simultâneo
BULLMQ_CONCURRENCY=2

# ============================================
# ☁️ SUPABASE (Storage + Auth)
# ============================================

SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key_here"
SUPABASE_BUCKET=certificates