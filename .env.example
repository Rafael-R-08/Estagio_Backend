# ============================================
# 🌐 APP SETTINGS
# ============================================

# Application
PORT=3000
NODE_ENV=development

# ============================================
# 🗄️ DATABASE (PostgreSQL + Prisma)
# ============================================
# Formato:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# ============================================
# 🔐 JWT AUTHENTICATION
# ============================================

# JWT Access
JWT_SECRET="CHANGE_ME_ACCESS_TOKEN_SECRET"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"

# JWT Refresh
JWT_REFRESH_TOKEN_SECRET="CHANGE_ME_REFRESH_SECRET"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# Account Verification
JWT_VERIFICATION_TOKEN_SECRET="CHANGE_ME_VERIFICATION_SECRET"
JWT_VERIFICATION_TOKEN_EXPIRES_IN="24h"

# Password Reset
JWT_PASSWORD_RESET_TOKEN_SECRET="CHANGE_ME_PASSWORD_RESET_SECRET"
JWT_PASSWORD_RESET_TOKEN_EXPIRES_IN="1h"

# ============================================
# ⚡ CACHE / REDIS
# ============================================

REDIS_URL=redis://localhost:6379

# ============================================
# 🤖 ARTIFICIAL INTELLIGENCE (Ollama)
# ============================================

# Host da API do Ollama
OLLAMA_HOST="http://localhost:11434"

# Modelos
LLM_MODEL="gemma2:2b"
EMBED_MODEL="nomic-embed-text"

# ============================================
# ☁️ AZURE BLOB STORAGE
# ============================================

AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=CHANGE_ME;AccountKey=CHANGE_ME;EndpointSuffix=core.windows.net"
AZURE_CONTAINER_NAME="certificates"