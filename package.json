    "@nestjs/throttler": "^6.5.0",
    "@playwright/test": "^1.58.2",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@supabase/supabase-js": "^2.100.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.71.1",
    "cheerio": "^1.2.0",
