  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "test:ai:smoke": "ts-node scripts/validate-ai-features.ts",
    "test:ai:flows": "ts-node scripts/validate-ai-flows.ts",
    "test:ai:endpoints": "ts-node scripts/test-ai-endpoints.ts",
    "db:cleanup-duplicates": "ts-node scripts/cleanup-duplicates.ts",
    "db:cleanup-non-training-courses:check": "ts-node scripts/cleanup-non-training-courses.ts",
    "db:cleanup-non-training-courses": "ts-node scripts/cleanup-non-training-courses.ts --apply",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
