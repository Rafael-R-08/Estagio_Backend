// ----------------------
// Prisma Schema - Learning Hub (Softinsa)
// ----------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---- Enums ----
enum Role {
  USER
  ADMIN
  SERVICE_LINE_MANAGER
}

enum ServiceLine {
  HYBRID_CLOUD
  DATA
  BUSINESS_APPLICATIONS
  APPLICATION_OPERATIONS
  SOURCING_TALENT_MANAGEMENT
}

enum ExperienceLevel {
  junior
  mid
  senior
  lead
}

enum TrainingStatus {
  accessed
  ongoing
  completed
  priority
  later
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum ChunkSource {
  EXTERNAL_COURSE
  COURSE_ANALYSIS
  RAG_KNOWLEDGE
}

// ---- Core Models ----

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  emailVerified   Boolean          @default(false)
  refreshTokens   RefreshToken[]
  passwordHash    String
  name            String?
  role            Role             @default(USER)
  experienceLevel ExperienceLevel?
  interests       String[] // ex: ["Cloud","DevOps"]

  userFunction      String?
  serviceLine    ServiceLine?
  onboardingDone Boolean      @default(false)
  managedLineId  ServiceLine?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  // relações
  trainings    TrainingRecord[]
  certificates Certificate[]
  settings     UserSettings?
  skills       UserSkill[]
}

// Plataformas
model LearningPlatform {
  id             String  @id @default(uuid())
  name           String  @unique
  type           String
  apiEndpoint    String?
  apiKeyRequired Boolean @default(false)
  apiKey         String?
  enabled        Boolean @default(true)
  searchEnabled  Boolean @default(true)
  config         Json    @default("{}")

  // relações
  trainings TrainingRecord[]
  courses   Course[]
}

// Registos de treino por utilizador (estado, rating, timestamps)
model TrainingRecord {
  id         String            @id @default(uuid())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  platform   LearningPlatform? @relation(fields: [platformId], references: [id])
  platformId String?

  title         String
  url           String
  status        TrainingStatus
  startedAt     DateTime?
  completedAt   DateTime?
  rating        Int?           @db.SmallInt
  relevance     Int?           @db.SmallInt
  notes         String?
  progressLevel String? // ex: "A iniciar", "Em evolução", "Finalizado"
  priorityOrder Int?    // Para ordenar na seção "Guardadas"

  createdAt DateTime @default(now())

  // relações
  certificate Certificate?
  documents   TrainingDocument[]

  @@index([userId])
  @@index([status])
}

model TrainingDocument {
  id         String         @id @default(uuid())
  training   TrainingRecord @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  trainingId String
  fileUrl    String
  fileName   String
  createdAt  DateTime       @default(now())

  @@index([trainingId])
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Certificados (evidências), associados ao treino e ao utilizador (renovações)
model Certificate {
  id         String         @id @default(uuid())
  training   TrainingRecord @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  trainingId String         @unique
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  fileUrl           String
  courseName        String?
  provider          String?
  completionDate    DateTime?
  expirationDate    DateTime?
  extractedMetadata Json?
  
  status            ProcessingStatus @default(PENDING)
  jobId             String?
  errorMessage      String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expirationDate])
}

// Cache de cursos por plataforma (para unified search + recomendações)
model Course {
  id         String           @id @default(uuid())
  platform   LearningPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  platformId String

  externalId    String
  title         String
  description   String?
  url           String
  instructor    String?
  rating        Float?
  durationHours Int?
  level         CourseLevel?
  isFree        Boolean?
  tags          String[]
  embedding     Unsupported("vector(384)")? // pgvector type for semantic search

  lastUpdated DateTime @default(now())

  @@index([platformId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
}

// Definições personalizadas do utilizador (notificações, aparência)
model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notificações
  notifyWeeklyRecs Boolean @default(true)
  notifyCertExpiry Boolean @default(true)
  notifyProgress   Boolean @default(true)
  notifyByEmail    Boolean @default(true)
  notifyInApp      Boolean @default(true)

  // Interface (Aparência)
  uiLanguage String @default("pt") // "pt" | "en"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Chunks de texto para testes de embedding e pesquisa semântica
model TextChunk {
  id            String                      @id @default(uuid())
  content       String
  embedding     Unsupported("vector(384)")
  source        ChunkSource                 @default(RAG_KNOWLEDGE)
  sourceId      String?
  metadata      Json?
  lastUpdatedAt DateTime?
  createdAt     DateTime                    @default(now())

  @@index([source])
  @@index([sourceId])
  @@map("text_chunks")
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName String
  yearsOfExperience Int
  level      String // e.g., 'beginner', 'intermediate', 'advanced'
  createdAt DateTime @default(now())

  @@index([userId])
}
