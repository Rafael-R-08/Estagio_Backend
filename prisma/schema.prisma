generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  emailVerified   Boolean          @default(false)
  passwordHash    String
  name            String?
  role            Role             @default(USER)
  experienceLevel ExperienceLevel?
  interests       String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isActive        Boolean          @default(true)
  managedLineId   ServiceLine?
  onboardingDone  Boolean          @default(false)
  serviceLine     ServiceLine?
  userFunction    String?
  certificates      Certificate[]
  refreshTokens     RefreshToken[]
  trainings         TrainingRecord[]
  settings          UserSettings?
  skills            UserSkill[]
  conversations     Conversation[]
  notifications     Notification[]
  calendarEvents    CalendarEvent[]
  collections       Collection[]
  pushSubscriptions PushSubscription[]
}

model LearningPlatform {
  id             String           @id @default(uuid())
  name           String           @unique
  type           String
  apiEndpoint    String?
  apiKeyRequired Boolean          @default(false)
  enabled        Boolean          @default(true)
  searchEnabled  Boolean          @default(true)
  config         Json             @default("{}")
  apiKey         String?
  courses        Course[]
  trainings      TrainingRecord[]
}

model TrainingRecord {
  id            String             @id @default(uuid())
  userId        String
  platformId    String?
  title         String
  url           String
  status        TrainingStatus
  startedAt     DateTime?
  completedAt   DateTime?
  notes         String?
  rating        Int?               @db.SmallInt
  createdAt     DateTime           @default(now())
  priorityOrder Int?
  progressLevel String?
  relevance     Int?               @db.SmallInt
  certificate   Certificate?
  documents     TrainingDocument[]
  platform      LearningPlatform?  @relation(fields: [platformId], references: [id])
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources     TrainingResource[]
  durationHours Float?

  @@index([userId])
  @@index([status])
}

model TrainingDocument {
  id         String         @id @default(uuid())
  trainingId String
  fileUrl    String
  fileName   String
  createdAt  DateTime       @default(now())
  training   TrainingRecord @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
}

model Certificate {
  id                String           @id @default(uuid())
  trainingId        String           @unique
  userId            String
  fileUrl           String
  courseName        String?
  provider          String?
  completionDate    DateTime?
  expirationDate    DateTime?
  extractedMetadata Json?
  createdAt         DateTime         @default(now())
  errorMessage      String?
  jobId             String?
  status            ProcessingStatus @default(PENDING)
  training          TrainingRecord   @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationHours     Float?

  @@index([userId])
  @@index([expirationDate])
}

model Course {
  id            String                 @id @default(uuid())
  platformId    String
  externalId    String
  title         String
  description   String?
  url           String
  instructor    String?
  rating        Float?
  durationHours Int?
  level         CourseLevel?
  tags          String[]
  embedding     Unsupported("vector")?
  lastUpdated   DateTime               @default(now())
  isFree        Boolean?
  language      String?
  platform      LearningPlatform       @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([externalId, platformId])
  @@index([platformId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserSettings {
  id               String   @id @default(uuid())
  userId           String   @unique
  notifyWeeklyRecs Boolean  @default(true)
  notifyCertExpiry Boolean  @default(true)
  notifyProgress   Boolean  @default(true)
  notifyByEmail    Boolean  @default(true)
  notifyInApp      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  uiLanguage       String   @default("pt")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TextChunk {
  id            String                @id @default(uuid())
  content       String
  embedding     Unsupported("vector")
  source        ChunkSource           @default(RAG_KNOWLEDGE)
  sourceId      String?
  metadata      Json?
  lastUpdatedAt DateTime?
  createdAt     DateTime              @default(now())

  @@unique([source, sourceId])
  @@index([source])
  @@index([sourceId])
  @@map("text_chunks")
}

model UserSkill {
  id        String     @id @default(uuid())
  userId    String
  skillName String
  createdAt DateTime   @default(now())
  level     SkillLevel
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TrainingResource {
  id         String         @id @default(uuid())
  trainingId String
  title      String
  content    String
  position   Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  files      ResourceFile[]
  training   TrainingRecord @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
}

model ResourceFile {
  id         String           @id @default(uuid())
  resourceId String
  fileUrl    String
  fileName   String
  createdAt  DateTime         @default(now())
  resource   TrainingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

enum Role {
  USER
  ADMIN
  SERVICE_LINE_MANAGER
}

enum ServiceLine {
  HYBRID_CLOUD
  DATA
  BUSINESS_APPLICATIONS
  APPLICATION_OPERATIONS
  SOURCING_TALENT_MANAGEMENT
}

enum ExperienceLevel {
  junior
  intermedio
  senior
  especialista
  lider
}

enum TrainingStatus {
  ongoing
  completed
  priority
  later
  accessed
  cancelled
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum SkillLevel {
  iniciante
  intermedio
  experiente
}

enum ChunkSource {
  EXTERNAL_COURSE
  COURSE_ANALYSIS
  RAG_KNOWLEDGE
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // "user" | "assistant" | "system"
  content        String
  metadata       Json?        // Stores tokens, model, sources, etc.
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  TRAINING_STARTED
  TRAINING_COMPLETED
  CERTIFICATE_PROCESSED
  CERTIFICATE_EXPIRING
  WEEKLY_RECOMMENDATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
  WELCOME
  GENERAL
  CALENDAR_REMINDER
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  adminId   String?
  targetId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

model CalendarEvent {
  id                    String   @id @default(uuid())
  userId                String
  title                 String
  description           String?
  eventDate             DateTime
  reminderMinutesBefore Int      @default(30)
  reminderFireAt        DateTime // eventDate - reminderMinutesBefore; used by scheduler
  dayBeforeNotified     Boolean  @default(false)
  dayOfNotified         Boolean  @default(false)
  finalReminderNotified Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventDate])
  @@index([reminderFireAt, finalReminderNotified])
}

model Collection {
  id          String             @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses     CollectionCourse[]

  @@index([userId])
}

model CollectionCourse {
  id           String     @id @default(uuid())
  collectionId String
  externalId   String
  title        String
  url          String
  platformId   String?
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, externalId])
  @@index([collectionId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
